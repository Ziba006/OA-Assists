# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file (it is already listed in .gitignore).

# MongoDB Atlas connection string.
# Replace USERNAME, PASSWORD and YOUR_CLUSTER with your own values.
# Keep the database name "oa_assist" at the end of the string.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/oa_assist

# Frontend origins allowed by CORS, comma separated.
# The default Vite dev server is already listed; add your deployed URL later.
FRONTEND_ORIGINS=http://localhost:5173
